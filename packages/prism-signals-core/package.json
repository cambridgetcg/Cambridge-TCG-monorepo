{
  "name": "@cambridge-tcg/prism-signals-core",
  "version": "0.1.0",
  "description": "Pure, extraction-ready PRISM Signals product catalog, presentation, and Telegram planning",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./presentation": {
      "types": "./src/presentation.ts",
      "import": "./src/presentation.ts",
      "default": "./src/presentation.ts"
    },
    "./product": {
      "types": "./src/product.ts",
      "import": "./src/product.ts",
      "default": "./src/product.ts"
    },
    "./telegram": {
      "types": "./src/telegram.ts",
      "import": "./src/telegram.ts",
      "default": "./src/telegram.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cambridge-tcg/opportunity-signal": "workspace:^",
    "@cambridge-tcg/product-flow": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
