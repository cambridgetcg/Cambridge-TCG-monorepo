{
  "framework": "remix",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --prod=false",
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "outputDirectory": "build",
  "regions": ["lhr1"],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "crons": [
    {
      "path": "/api/cron/tier-maintenance",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/webhook-cleanup",
      "schedule": "0 5 * * 0"
    },
    {
      "path": "/api/cron/session-cleanup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scheduled-campaigns",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/cashback-reconciliation",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/tier-recalculation",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/tier-product-cleanup",
      "schedule": "30 3 * * *"
    }
  ]
}
