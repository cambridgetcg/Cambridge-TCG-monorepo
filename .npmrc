# Keep React type packages out of pnpm's hidden hoist fallback
# (node_modules/.pnpm/node_modules). While the old RewardsPro app was here the
# workspace held two React worlds (@types/react 19 and 18) and the hoist winner
# was nondeterministic. Next.js's own .d.ts files resolve `react` through that
# fallback, so an 18.x winner broke the React-19 apps' typecheck. Unhoisted,
# every app resolves @types/react from its own declared dependency. Types are
# compile-time only; nothing resolves them at runtime, so unhoisting is safe.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
